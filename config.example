# The settings of this machine. Copy this file to ~/.config/minion-army/config and change it there.
# The engine sources it at the start of each round and each slot.

# Each source repository of this account (no forks, no archived ones) with .minion/config.sh on its
# dev branch takes part. The engine checks for new ones once an hour.
ACCOUNT=owner

# More repositories, in addition to the ones of ACCOUNT. Each one needs .minion/config.sh on dev too.
REPOS=()

# Telegram messages: "owner" sends one each time the loop stops and waits for you, "all" also sends
# the progress: pull requests opened, corrected and merged, and dev deployed. The bot token and the chat
# go in agent.env as TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID.
NOTIFY=owner

# The number of slots for the whole machine: WORKERS for new issues and corrections, REVIEWERS for reviews.
WORKERS=2
REVIEWERS=2
